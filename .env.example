
# CLEO application configuration

APP_NAME=CLEO
APP_DESCRIPTION=Cognitive Logic & Executive Operator
APP_VERSION=0.1.0

# Application environment
ENVIRONMENT=development

# Debug and logging
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./cleo.db

# AI provider: openai or local
AI_PROVIDER=local

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Local Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
